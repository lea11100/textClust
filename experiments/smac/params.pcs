model categorical {sentenceTransformers, minishlab, clips, maniac} [sentenceTransformers]

clean_interval integer [20,500] [100]
cluster_interval integer [100,5000] [1000]

decay_rate real [0.00005,0.05] [0.0005] log
min_num_mc integer [1,30] [5]

adaptive_threshold integer [0,1] [1]
sigma real [0.1,3.0] [1.0]
radius real [0.01,0.8] [0.2]
threshold_momentum real [0.0,1.0] [0.5]

use_heuristic integer [0,1] [1]
time_gap real [10.0,5000.0] [1000.0]
min_weight real [0.00001,0.5] [0.01] log

sigma | adaptive_threshold in {1}
threshold_momentum | adaptive_threshold in {1}
radius | adaptive_threshold in {0}

time_gap | use_heuristic in {1}
min_weight | use_heuristic in {0}
