
Bootstrap: docker
From: python:3.11-slim

%files
    requirements.txt /opt/project/requirements.txt
    pyproject.toml /opt/project/pyproject.toml
    README.md /opt/project/README.md
    src /opt/project/src

%post
    python -m pip install --no-cache-dir --upgrade pip

    cd /opt/project
    python -m pip install -e .

    # %environment stages the extracted corpus under the runtime user's UID.
    python -m nltk.downloader -d /usr/local/share/nltk_data stopwords

    python -m pip install pytest-xdist
    
    # Check dependency consistency
    python -m pip check

%environment
    export PYTHONUNBUFFERED=1
    export TEXTCLUST_RUN_DATASET_TESTS=1

    # Fakeroot-built files can appear owned by nobody at runtime. NLTK refuses
    # to load them directly, so stage the corpus in a private user-owned directory.
    NLTK_DATA=$(mktemp -d /tmp/textclust-nltk.XXXXXXXX) || exit 1
    mkdir "$NLTK_DATA/corpora" || exit 1
    cp -R /usr/local/share/nltk_data/corpora/stopwords "$NLTK_DATA/corpora/" || exit 1
    export NLTK_DATA

%runscript
    exec python "$@"
